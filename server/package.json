{
  "name": "@ai-panel/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:report": "node ../scripts/db-report.mjs",
    "test": "vitest run",
    "probe": "node ../scripts/health-probe.mjs"
  },
  "dependencies": {
    "@ai-panel/shared": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
